{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://industry-blueprints.github.io/schemas/blueprint.schema.json",
  "title": "Industry Blueprints artifact",
  "type": "object",
  "required": [
    "id",
    "title",
    "type",
    "level",
    "version",
    "status",
    "description",
    "last_updated",
    "tracks",
    "relationships"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": { "type": "string", "minLength": 1 },
    "type": {
      "enum": [
        "system",
        "foundation",
        "persona",
        "capability-area",
        "capability",
        "architecture",
        "solution-pattern",
        "workload",
        "reference-scenario",
        "platform-realization"
      ]
    },
    "level": { "type": "integer", "minimum": 0, "maximum": 6 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "status": { "enum": ["draft", "stable", "deprecated"] },
    "description": { "type": "string", "minLength": 1 },
    "last_updated": { "type": "string", "format": "date" },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "business",
          "experience-process",
          "information",
          "architecture",
          "trust-governance",
          "ai-automation",
          "executable"
        ]
      }
    },
    "industries": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "missions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "capability_area": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "content_profile": {
      "enum": ["educational"]
    },
    "realization_kind": {
      "enum": ["sample", "platform-mapping"]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "url"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "minLength": 1 },
          "note": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "reviewed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["by", "at"],
        "properties": {
          "by": { "type": "string", "minLength": 1 },
          "at": { "type": "string", "format": "date" },
          "note": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "relationships": {
      "type": "object",
      "required": ["builds_on", "adds"],
      "properties": {
        "builds_on": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "adds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "personas": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "realizes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "type": { "const": "capability" } },
        "required": ["type"]
      },
      "then": { "required": ["capability_area"] }
    },
    {
      "if": {
        "properties": { "type": { "const": "platform-realization" } },
        "required": ["type"]
      },
      "then": { "required": ["realization_kind"] }
    }
  ],
  "additionalProperties": true
}
